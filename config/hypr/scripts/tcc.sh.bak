#!/usr/bin/env bash
# Waybar module for TUXEDO Control Center (tccd).
#
#   tcc.sh                  emit waybar JSON
#   tcc.sh --next-profile   cycle TCC profile (fan curve)
#   tcc.sh --next-charging  cycle charging profile
#
# TCC reports powerDraw and fan speed as -1 on this machine, so watts and
# temp are read from hwmon instead. hwmon numbering shifts across boots,
# so both are resolved by driver name at runtime.

set -uo pipefail

DEST=com.tuxedocomputers.tccd
OBJ=/com/tuxedocomputers/tccd

call() { busctl --json=short call "$DEST" "$OBJ" "$DEST" "$@" 2>/dev/null | jq -r '.data[0]' 2>/dev/null; }

hwmon() {
  local h
  for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "$1" ] && { printf '%s' "$h"; return 0; }
  done
  return 1
}

# next item after $1 in the newline-separated list on stdin, wrapping around
cycle() { awk -v cur="$1" '{a[n++]=$0} END{for(i=0;i<n;i++) if(a[i]==cur){print a[(i+1)%n]; exit} if(n) print a[0]}'; }

next_profile() {
  local cur; cur=$(call GetActiveProfileJSON | jq -r '.id // empty')
  [ -n "$cur" ] || exit 1
  call SetTempProfileById s "$(call GetProfilesJSON | jq -r '.[].id' | cycle "$cur")" >/dev/null
}

next_charging() {
  local cur; cur=$(call GetCurrentChargingProfile)
  [ -n "$cur" ] || exit 1
  call SetChargingProfile s "$(call GetChargingProfilesAvailable | jq -r '.[]' | cycle "$cur")" >/dev/null
}

status() {
  local active name fan charging gpu cpu watts temp text tooltip

  active=$(call GetActiveProfileJSON)
  if [ -z "$active" ]; then
    jq -cn '{text:"󰈐 n/a", tooltip:"tccd not responding", class:"off"}'
    return
  fi

  name=$(jq -r '.name // "?"'            <<<"$active")
  fan=$(jq  -r '.fan.fanProfile // "-"'  <<<"$active")
  charging=$(call GetCurrentChargingProfile)

  gpu=$(hwmon amdgpu)  && watts=$(awk '{printf "%.0f", $1/1000000}' "$gpu/power1_average" 2>/dev/null)
  cpu=$(hwmon k10temp) && temp=$(awk  '{printf "%.0f", $1/1000}'    "$cpu/temp1_input"    2>/dev/null)

  text="󰈐 ${watts:-?}W ${temp:-?}°C"
  tooltip="Profile:  ${name}
Fan:      ${fan}
Charging: ${charging:-unknown}
Package:  ${watts:-?} W
CPU temp: ${temp:-?} °C

Left click:  next TCC profile
Right click: next charging profile"

  jq -cn --arg t "$text" --arg tt "$tooltip" --arg c "${fan,,}" \
    '{text:$t, tooltip:$tt, class:$c}'
}

case "${1-}" in
  --next-profile)  next_profile ;;
  --next-charging) next_charging ;;
  *)               status ;;
esac
