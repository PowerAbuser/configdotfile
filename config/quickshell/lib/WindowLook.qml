pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io

// Hyprland window settings from Settings > Windows (after dhrruvsharma/shell's
// customizer chapter IV). Each change is applied live with `hyprctl eval` and
// written twice:
//   - windowlook.json next to shell.qml: what the panel shows
//   - ~/.config/hypr/confs/windowlook.lua: the same settings as an hl.config
//     table, which confs/decoration_common.lua applies after the theme on
//     every reload
// Defaults match confs/configs.lua, so an untouched panel changes nothing.
Singleton {
    id: root

    readonly property var defaults: ({
        gaps_in: 3, gaps_out: 0, border_size: 1, rounding: 5,
        active_opacity: 100, inactive_opacity: 100, dim_inactive: false,
        blur: true, blur_size: 5, blur_passes: 3,
        shadow: true, shadow_range: 0,
        animations: true
    })
    property var values: ({})
    property bool ready: false

    function get(key) {
        return root.values[key] !== undefined ? root.values[key] : root.defaults[key]
    }

    function set(key, value) {
        var v = Object.assign({}, root.values)
        v[key] = value
        root.values = v
        root._persist()
        Quickshell.execDetached(["hyprctl", "eval", "hl.config(" + root.luaTable() + ")"])
    }

    function resetAll() {
        root.values = ({})
        root._persist()
        Quickshell.execDetached(["hyprctl", "eval", "hl.config(" + root.luaTable() + ")"])
    }

    // The settings as a Lua hl.config table
    function luaTable() {
        var g = root.get
        return "{ general = { gaps_in = " + g("gaps_in") + ", gaps_out = " + g("gaps_out")
            + ", border_size = " + g("border_size") + " },"
            + " decoration = { rounding = " + g("rounding")
            + ", active_opacity = " + (g("active_opacity") / 100)
            + ", inactive_opacity = " + (g("inactive_opacity") / 100)
            + ", dim_inactive = " + g("dim_inactive")
            + ", blur = { enabled = " + g("blur") + ", size = " + g("blur_size") + ", passes = " + g("blur_passes") + " }"
            + ", shadow = { enabled = " + g("shadow") + ", range = " + g("shadow_range") + " } },"
            + " animations = { enabled = " + g("animations") + " } }"
    }

    function _persist() {
        jsonFile.setText(JSON.stringify(root.values, null, 2) + "\n")
        luaFile.setText("-- Generated by quickshell Settings > Windows (lib/WindowLook.qml). Do not edit.\n"
            + "-- Applied by confs/decoration_common.lua after the theme.\n"
            + "return " + root.luaTable() + "\n")
    }

    FileView {
        id: jsonFile
        path: Qt.resolvedUrl("../windowlook.json").toString().replace("file://", "")
        preload: true
        printErrors: false
        onLoaded: {
            try { root.values = JSON.parse(text()) || ({}) } catch (e) { root.values = ({}) }
            root.ready = true
        }
        onLoadFailed: root.ready = true
    }

    FileView {
        id: luaFile
        path: Quickshell.env("HOME") + "/.config/hypr/confs/windowlook.lua"
        printErrors: false
    }
}
