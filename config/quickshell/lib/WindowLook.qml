pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "../desktoptheme" as DT

// Hyprland window settings from Settings > Windows (after dhrruvsharma/shell's
// customizer chapter IV). Each change is applied live with `hyprctl eval` and
// written twice:
//   - windowlook.json next to shell.qml: what the panel shows
//   - ~/.config/hypr/confs/windowlook.lua: the same settings as an hl.config
//     table, which confs/decoration.lua applies after the theme on
//     every reload
// Only keys you've changed are written, so a desktop theme's rounding and
// shadows stay unless you move that slider; an untouched key shows the
// theme's value, or confs/configs.lua's when no theme is on.
Singleton {
    id: root

    readonly property var defaults: ({
        gaps_in: 3, gaps_out: 0, border_size: 1, rounding: 5,
        active_opacity: 100, inactive_opacity: 100, dim_inactive: false,
        blur: true, blur_size: 5, blur_passes: 3,
        shadow: true, shadow_range: 0,
        animations: true
    })
    property var values: ({})
    property bool ready: false

    // What an unset key is right now: the desktop theme's, else the config's
    function _base(key) {
        const t = DT.DesktopTheme.enabled ? DT.DesktopTheme.current.hypr : null
        if (t) {
            if (key === "rounding") return t.rounding
            if (key === "shadow_range") return t.range
            if (key === "dim_inactive" && t.dim) return true
        }
        return root.defaults[key]
    }

    function get(key) {
        return root.values[key] !== undefined ? root.values[key] : root._base(key)
    }
    function isSet(key) { return root.values[key] !== undefined }

    function set(key, value) {
        var v = Object.assign({}, root.values)
        v[key] = value
        root.values = v
        root._persist()
        Quickshell.execDetached(["hyprctl", "eval", "hl.config(" + root.luaTable() + ")"])
    }

    // Back to the theme's / config's look: a (checked) reload rebuilds it
    function resetAll() {
        root.values = ({})
        root._persist()
        Quickshell.execDetached([Quickshell.env("HOME") + "/.config/hypr/scripts/safe-reload.sh"])
    }

    // The keys you've set, as a Lua hl.config table
    readonly property var _paths: ({
        gaps_in: ["general", "gaps_in"], gaps_out: ["general", "gaps_out"], border_size: ["general", "border_size"],
        rounding: ["decoration", "rounding"],
        active_opacity: ["decoration", "active_opacity", 0.01], inactive_opacity: ["decoration", "inactive_opacity", 0.01],
        dim_inactive: ["decoration", "dim_inactive"],
        blur: ["decoration", "blur", "enabled"], blur_size: ["decoration", "blur", "size"], blur_passes: ["decoration", "blur", "passes"],
        shadow: ["decoration", "shadow", "enabled"], shadow_range: ["decoration", "shadow", "range"],
        animations: ["animations", "enabled"]
    })

    function luaTable() {
        const tree = {}
        for (const key in root.values) {
            const p = root._paths[key]
            if (!p) continue
            const scale = typeof p[p.length - 1] === "number" ? p[p.length - 1] : 1
            const names = p.filter(x => typeof x === "string")
            let node = tree
            for (let i = 0; i < names.length - 1; i++) node = node[names[i]] = node[names[i]] || {}
            const v = root.values[key]
            node[names[names.length - 1]] = typeof v === "number" ? v * scale : v
        }
        const lua = n => typeof n === "object"
            ? "{ " + Object.keys(n).map(k => k + " = " + lua(n[k])).join(", ") + " }"
            : String(n)
        return lua(tree)
    }

    function _persist() {
        jsonFile.setText(JSON.stringify(root.values, null, 2) + "\n")
        luaFile.setText("-- Generated by quickshell Settings > Windows (lib/WindowLook.qml). Do not edit.\n"
            + "-- Applied by confs/decoration.lua after the theme.\n"
            + "return " + root.luaTable() + "\n")
    }

    FileView {
        id: jsonFile
        path: Qt.resolvedUrl("../windowlook.json").toString().replace("file://", "")
        preload: true
        printErrors: false
        onLoaded: {
            try { root.values = JSON.parse(text()) || ({}) } catch (e) { root.values = ({}) }
            root.ready = true
        }
        onLoadFailed: root.ready = true
    }

    FileView {
        id: luaFile
        path: Quickshell.env("HOME") + "/.config/hypr/confs/windowlook.lua"
        printErrors: false
    }
}
