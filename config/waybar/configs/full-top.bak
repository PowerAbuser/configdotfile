{
  "include": [
    "$HOME/.config/waybar/modules/modules-main.jsonc",
    "$HOME/.config/waybar/modules/modules-groups.jsonc",
    "$HOME/.config/waybar/modules/modules-custom.jsonc"
  ],
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,
  "height": 20,
  "margin-top": 3,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "custom/launch_rofi",
    "clock",
    "tray",
    "power-profiles-daemon",
    "mpris"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "backlight",
    "pulseaudio",
    "pulseaudio#microphone",
    "cpu",
    "memory",
    "custom/clipboard",
    "custom/notify",
    "battery",
    "custom/power_btn"
  ]
}
