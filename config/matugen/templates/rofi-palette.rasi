/* Generated by matugen. Imported by style-dark.rasi and style-light.rasi
   after their own palette, so it overrides it. */
* {
    background:     {{colors.surface_container.default.hex}};
    background-alt: {{colors.surface_container_highest.default.hex}};
    foreground:     {{colors.on_surface.default.hex}};
    placeholder:    {{colors.on_surface_variant.default.hex}}aa;
    selected:       {{colors.primary.default.hex}};
    selected-soft:  {{colors.primary.default.hex}}70;
    on-selected:    {{colors.on_primary.default.hex}};
    active:         {{colors.surface_bright.default.hex}};
    active-alt:     {{colors.outline_variant.default.hex}};
    urgent:         {{colors.orange.default.hex}};
    on-urgent:      {{colors.on_orange.default.hex}};
    grad-selected:  linear-gradient(to right, {{colors.primary.default.hex}}, {{colors.tertiary.default.hex}});
    grad-alt:       linear-gradient(to right, {{colors.surface_container_highest.default.hex}}, {{colors.surface_bright.default.hex}});
}
